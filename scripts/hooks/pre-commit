#!/usr/bin/env bash
# Tracked source for the pre-commit hook. Install with scripts/install-hooks.sh.
# Bypass deliberately with: git commit --no-verify
set -uo pipefail
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check-repo.sh" || {
  echo "pre-commit: repo gate failed — fix it, or commit with --no-verify if you know why"
  exit 1
}
